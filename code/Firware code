// --- Web Server Request Handlers ---
void handleRoot() {
  server.send_P(200, "text/html", WEB_PAGE);
}

void handleData() {
  String json = "{";
  json += "\"angle\":" + String(firingAngle) + ",";
  json += "\"voltage\":" + String((analogRead(ZMPT_PIN) / 4095.0) * 12.0) + ",";
  json += "\"thermal\":" + String(thermalCapacity) + ",";
  json += "\"tripped\":" + String(mcbTrippedState ? 1 : 0);
  json += "}";
  server.send(200, "application/json", json);
}

void handleReset() {
  mcbTrippedState = false;
  thermalCapacity = 0.0;
  server.send(200, "text/plain", "OK");
}

void setup() {
  Serial.begin(115200);
  
  Wire.begin(21, 22);

  // Configure Pin Modes
  pinMode(ZC_PIN, INPUT_PULLUP);
  pinMode(ENC_CLK, INPUT_PULLUP);
  pinMode(ENC_DT, INPUT_PULLUP);
  pinMode(ENC_SW, INPUT_PULLUP);

  pinMode(LED_GREEN, OUTPUT);
  pinMode(LED_RED, OUTPUT);

  // Attach Interrupts
  attachInterrupt(digitalPinToInterrupt(ZC_PIN), onZeroCross, FALLING);
  attachInterrupt(digitalPinToInterrupt(ENC_CLK), handleEncoder, FALLING);

  // Initialize OLED Display
  u8g2.begin();

  // --- Start Wi-Fi Access Point ---
  WiFi.softAP(apSSID, apPassword);
  IPAddress myIP = WiFi.softAPIP();
  Serial.println("");
  Serial.print("Access Point Started! IP Address: ");
  Serial.println(myIP);

  // --- Setup Web Server Routes ---
  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/reset", handleReset);
  server.begin();
  Serial.println("HTTP server started.");
}

void loop() {
  server.handleClient(); // Handle incoming web client requests

  // Reset trip state if physical encoder push-button is pressed
  if (digitalRead(ENC_SW) == LOW) {
    mcbTrippedState = false;
    thermalCapacity = 0.0;
    delay(300); // Debounce delay
  }

  // --- Read Voltage Sensor (ZMPT101B) ---
  int rawVoltage = analogRead(ZMPT_PIN);
  float voltageVal = (rawVoltage / 4095.0) * 12.0; 

  // --- Digital Twin Thermal Accumulation (I^2t Simulation) ---
  if (!mcbTrippedState) {
    float angleSeverity = sin((firingAngle * 3.14159) / 180.0); 
    float heatInput = (angleSeverity * angleSeverity) * 2.5; 
    
    thermalCapacity += heatInput;

    // Cool down when firing at zero-crossing points (0, 180, or 360 degrees)
    if (firingAngle == 0 || firingAngle == 180 || firingAngle == 360) {
      thermalCapacity -= 1.5; 
      if (thermalCapacity < 0) thermalCapacity = 0.0;
    }

    // Check if thermal threshold is breached
    if (thermalCapacity >= tripThreshold) {
      thermalCapacity = 100.0;
      mcbTrippedState = true;
    }
  }

  // --- Update Physical Status LEDs ---
  if (mcbTrippedState || thermalCapacity > 75.0) {
    digitalWrite(LED_RED, HIGH);    // Red ON (Fault / High Stress)
    digitalWrite(LED_GREEN, LOW);   // Green OFF
  } else {
    digitalWrite(LED_RED, LOW);     // Red OFF
    digitalWrite(LED_GREEN, HIGH);  // Green ON (Normal)
  }

  // --- Update OLED Display: Full Wave + Horizontal Cursor ---
  u8g2.clearBuffer();
  
  // 1. Top status line (Shows angle only)
  u8g2.setFont(u8g2_font_6x10_tr);
  u8g2.setCursor(0, 9);
  u8g2.print("Phase Angle: ");
  u8g2.print(firingAngle);
  u8g2.print(" Deg");

  // 2. Draw Full AC Sine Wave Graph (0 to 360 degrees across 128 pixels)
  int centerY = 38;
  int amplitude = 18;
  
  // Draw zero baseline (dotted center line)
  for (int x = 0; x < 128; x += 4) {
    u8g2.drawPixel(x, centerY);
  }

  // Draw Full Sine Wave Cycle (Positive & Negative lobes: 0 to 2*pi radians)
  for (int x = 0; x < 128; x++) {
    float rad = (x / 127.0) * 2.0 * 3.14159; 
    int y = centerY - (sin(rad) * amplitude);
    u8g2.drawPixel(x, y);
  }

  // 3. Draw Moving Cursor Line (Vertical line moving horizontally across the full wave)
  int cursorX = map(firingAngle, 0, 360, 0, 127);
  for (int y = 14; y <= 62; y += 2) {
    u8g2.drawPixel(cursorX, y); // Dotted vertical cursor line
  }
  // Small pointer triangle at the top of the cursor
  u8g2.drawTriangle(cursorX, 13, cursorX - 2, 10, cursorX + 2, 10);
  
  u8g2.sendBuffer();

  delay(50); 
}
