// --- Pin Definitions ---
const int ZC_PIN = 34;          // H11AA1 Zero-Cross Input
const int ZMPT_PIN = 35;        // ZMPT101B Voltage ADC Input

// Rotary Encoder Pins
const int ENC_CLK = 18;
const int ENC_DT = 19;
const int ENC_SW = 23;

// Physical Status LED Pins
const int LED_GREEN = 26;
const int LED_RED = 27;

// --- OLED Setup (128x64 SSD1306 I2C) ---
U8G2_SSD1306_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, /* reset=*/ U8X8_PIN_NONE);

// --- System Variables ---
volatile int firingAngle = 90;         // 0 to 360 degrees for full wave
unsigned long delayMicros = 0;       
volatile bool zeroCrossDetected = false;

// --- Digital Twin Thermal Variables (I^2t) ---
float thermalCapacity = 0.0;           
const float tripThreshold = 100.0;     
bool mcbTrippedState = false;

// --- Zero-Crossing Interrupt Service Routine ---
void IRAM_ATTR onZeroCross() {
  zeroCrossDetected = true;
  delayMicros = (10000L * firingAngle) / 360L;
}

// --- Rotary Encoder Interrupt (Full 0-360 Degree Range) ---
void IRAM_ATTR handleEncoder() {
  static unsigned long lastInterruptTime = 0;
  unsigned long interruptTime = millis();
  
  if (interruptTime - lastInterruptTime > 2) {
    if (digitalRead(ENC_DT) == HIGH) {
      firingAngle += 5;
      if (firingAngle > 360) firingAngle = 360;
    } else {
      firingAngle -= 5;
      if (firingAngle < 0) firingAngle = 0;
    }
    lastInterruptTime = interruptTime;
  }
}

